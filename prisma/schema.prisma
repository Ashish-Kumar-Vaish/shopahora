generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  pending
  processing
  completed
  cancelled
}

model User {
  id      String @id @default(cuid())
  clerkId String @unique
  name    String
  email   String @unique

  cartItems CartItem[]
  orders    Order[]
  addresses Address[]

  createdAt DateTime @default(now())
}

model Address {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName    String
  phoneNumber String
  area        String
  city        String
  state       String
  zipCode     String
  country     String

  createdAt DateTime @default(now())

  @@index([userId])
}

model Product {
  id          String  @id @default(cuid())
  name        String
  price       Int
  currency    String
  salePrice   Int?
  description String
  category    String?
  stock       Int     @default(0)
  isActive    Boolean @default(true)

  imageUrls String[]
  colors    String[]
  sizes     String[]

  characteristics Json?
  highlight       String?

  orderItems OrderItem[]
  cartItems  CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([category])
  @@index([price])
}

model Order {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  items OrderItem[]

  totalAmount Int
  currency    String

  addressSnapshot Json

  status OrderStatus @default(pending)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity  Int
  unitPrice Int
  currency  String

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model CartItem {
  userId    String
  productId String
  quantity  Int

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}
